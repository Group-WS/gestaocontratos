# Copie para .env e preencha com os dados do seu projeto Supabase.
# Estas duas são PÚBLICAS (podem ir pro frontend). A secret key NÃO entra aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# ── Sienge (solicitação de compra) ────────────────────────
# NÃO ficam aqui. As credenciais do Sienge são do SERVIDOR
# (web/api/_lib/sienge.js), e este arquivo é lido pelo Vite, que só
# entrega ao navegador o que começa com VITE_ — credencial no bundle é
# credencial publicada.
#
# Onde configurar:
#   dev        monday-proxy/.env  (é ele que roda o backend na 3001)
#   produção   variáveis de ambiente da Vercel
#
# São SIENGE_BASE_URL, SIENGE_SUBDOMAIN, SIENGE_USERNAME e
# SIENGE_PASSWORD — os mesmos nomes do agendadefretesws.

# ── Google Maps (mapa de obras no Início) ─────────────────
# Chave de NAVEGADOR (vai no bundle, é pública por natureza): restrinja no
# Google Cloud por HTTP referrer (contratos.groupws.com.br/*, *.vercel.app/*,
# localhost:*) e por API (Maps JavaScript API). Sem ela, o mapa usa o SVG.
VITE_GOOGLE_MAPS_API_KEY=
